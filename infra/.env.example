# Copy to infra/.env for local docker-compose runs.

POSTGRES_DB=kharchakhata
POSTGRES_USER=kharchakhata
POSTGRES_PASSWORD=kharchakhata

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# JWT signing — generate infra/secrets/jwt-private.pem with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out infra/secrets/jwt-private.pem
APP_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
APP_JWT_ACTIVE_KID=v1
APP_JWT_ISSUER=auth_engine

# AES-256-GCM key for login_tokens at rest (base64 of 32 random bytes). Generate with:
#   openssl rand -base64 32
APP_TOKEN_ENC_KEY=

# Shared secret for /internal/** service-to-service auth.
INTERNAL_SVC_TOKEN=

CORS_ALLOWED_ORIGINS=http://localhost:3000
